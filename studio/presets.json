    "description": "사이키델릭 만다라 · 방사 대칭 + 컬러 회전",
    "shader": "mandala.frag",
    "params": {
      "speed":      { "section": "general", "type": "float", "min": 0.0, "max": 3.0,  "default": 0.5,  "label": "Speed" },
      "symmetry":   { "section": "shape",   "type": "int",   "min": 3,   "max": 16,   "default": 8,    "label": "Symmetry" },
      "zoom":       { "section": "shape",   "type": "float", "min": 0.3, "max": 3.0,  "default": 1.0,  "label": "Zoom" },
      "hueShift":   { "section": "color",   "type": "float", "min": 0.0, "max": 1.0,  "default": 0.0,  "label": "Hue Shift" },
      "saturation": { "section": "color",   "type": "float", "min": 0.0, "max": 1.5,  "default": 1.0,  "label": "Saturation" }
    },
    "audioMap": { "symmetry": "none", "zoom": "bass", "speed": "none", "hueShift": "treble", "saturation": "none" }
  },
  {
