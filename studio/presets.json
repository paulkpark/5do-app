[
  {
    "id": "mandala",
    "name": "Arcane Tessera",
    "description": "칼레이도스코픽 IFS · 신성기하 방사 대칭 + 2D 프랙탈 폴드",
    "shader": "mandala.frag",
    "params": {
      "speed":      { "section": "general", "type": "float", "min": 0.0, "max": 2.0,  "default": 0.6,  "label": "Speed" },
      "symmetry":   { "section": "shape",   "type": "float", "min": 3.0, "max": 24.0, "default": 8.0,  "label": "Symmetry", "smooth": false, "step": 1 },
      "iterations": { "section": "shape",   "type": "float", "min": 1.0, "max": 6.0,  "default": 4.0,  "label": "Iterations", "smooth": false, "step": 1 },
      "complexity": { "section": "shape",   "type": "float", "min": 0.0, "max": 1.0,  "default": 0.4,  "label": "Complexity" },
      "bloom":      { "section": "color",   "type": "float", "min": 0.0, "max": 1.5,  "default": 0.6,  "label": "Bloom" },
      "beatPulse":  { "section": "audio",   "type": "float", "min": 0.0, "max": 1.0,  "default": 1.0,  "label": "Beat Pulse", "smooth": false }
    },
    "audioMap": { "complexity": "midPres", "bloom": "trebleHit", "iterations": "none" }
  },
  {
    "id": "flux",
