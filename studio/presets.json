      "shape":           { "section": "shape",   "type": "float", "min": 0.0, "max": 1.0, "default": 0.3,  "label": "Shape" },
      "zoom":            { "section": "shape",   "type": "float", "min": 0.5, "max": 2.0, "default": 1.0,  "label": "Zoom" },
