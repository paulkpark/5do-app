      "twist":   { "section": "shape",   "type": "float", "min": 0.0, "max": 1.0, "default": 0.25, "label": "Twist" },
      "tunnel":  { "section": "shape",   "type": "float", "min": 0.0, "max": 1.0, "default": 0.0, "label": "Tunnel", "smooth": false },
