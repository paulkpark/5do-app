# Karleido Studio — environment
# Copy to `.env` and fill in with YOUR Google OAuth credentials.
# `.env` is gitignored — keep it local only.

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Desktop app)
# Add "http://localhost:10001/api/youtube/auth/callback" as an Authorized redirect URI.
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:10001/api/youtube/auth/callback
